# Postgres connection string (Supabase, Neon, or local).
# If using Supabase: use the "Session pooler" connection string from
# Project Settings -> Database -> Connection pooling, not the direct
# db.<ref>.supabase.co host -- that one is IPv6-only and unreachable
# from a lot of networks/sandboxes.
DATABASE_URL="postgresql://user:password@localhost:5432/ldr_tracker?schema=public"

# Each person's calendar sync feed (Apple "Public Calendar" link or Google
# "Secret address in iCal format"), keyed by their id in src/lib/people.ts.
# Set these in Vercel's project env vars, not in this file -- they're
# personal calendar URLs, not something to commit to the repo. Once set,
# the Calendar page syncs from them automatically, no upload/connect step.
ICS_URL_FIONA=""
ICS_URL_JAKE=""

# Random 32-byte hex key used to encrypt Google refresh tokens at rest (openssl rand -hex 32)
GOOGLE_TOKEN_ENC_KEY="change-me"

# Google Cloud OAuth client (Calendar API, read-only scope)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/google/oauth/callback"

# SerpApi key, used for real nonstop fares via the Google Flights engine.
# Free tier is 250 searches/month; results are cached for 12h per route+date
# so browsing several weekends stays well inside that. Without this, the
# "Plan a trip" page falls back to clearly-labelled placeholder fares.
# (Amadeus Self-Service was decommissioned on 17 July 2026.)
SERPAPI_API_KEY=""
