# Postgres connection string (Supabase, Neon, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/ldr_tracker?schema=public"

# Random 32-byte hex key used to encrypt Google refresh tokens at rest (openssl rand -hex 32)
GOOGLE_TOKEN_ENC_KEY="change-me"

# Google Cloud OAuth client (Calendar API, read-only scope)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/google/oauth/callback"

# Amadeus Self-Service API (test/sandbox environment to start)
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
