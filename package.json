{
  "name": "ldr-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:demo": "tsx scripts/seed-demo.ts",
    "db:backfill": "tsx scripts/backfill-trips.ts",
    "setup": "npm run db:up && npm run db:migrate && npm run db:seed && npm run db:demo"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "node-ical": "^0.27.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
